# Server-only Supabase Edge Function environment. Never put values in dist/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_SUBJECT=mailto:YOUR-EMAIL
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
REMINDER_CRON_SECRET=
# Optional integration-test inputs; use two dedicated beta accounts.
MGT_TEST_EMAIL_A=
MGT_TEST_PASSWORD_A=
MGT_TEST_EMAIL_B=
MGT_TEST_PASSWORD_B=
SUPABASE_PUBLISHABLE_KEY=

# Isolated acceptance only. Never set these to the live project's reference.
MENEI_TEST_PROJECT_REF=
# Required before cloud-smoke can create synthetic account snapshots.
MENEI_ALLOW_TEST_WRITES=
# Optional, only after the isolated reminder function is deployed (send-reminders).
MENEI_TEST_REMINDER_FUNCTION=
